{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hive.dev/schemas/usage.schema.json",
  "title": "Agent Hive Usage Ledger",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "cells"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "cells": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "used"],
        "properties": {
          "status": { "enum": ["pending", "in_progress", "done", "partial", "blocked", "failed"] },
          "used": { "type": "integer", "minimum": 0 },
          "attempts": { "type": "integer", "minimum": 0 },
          "usageKnown": {
            "type": "boolean",
            "description": "False means used is only a confirmed lower bound and dispatch is blocked until explicit reconciliation."
          },
          "unknownAttempts": { "type": "integer", "minimum": 0 },
          "metricsAvailable": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["modelCalls", "inputTokens", "cachedInputTokens", "outputTokens", "reasoningTokens", "latencyMs", "costUsd"] },
            "description": "Metric categories reported completely across cumulative attempts; omitted categories are unavailable, not measured zero."
          },
          "reasoningTokensKnown": {
            "type": "boolean",
            "description": "Whether reasoning diagnostics are available; reasoning is a subset of output, not additional spend."
          },
          "revision": { "type": "integer", "minimum": 0 },
          "dependencyRevisions": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "modelCalls": { "type": "integer", "minimum": 0 },
              "inputTokens": { "type": "integer", "minimum": 0 },
              "cachedInputTokens": { "type": "integer", "minimum": 0 },
              "outputTokens": { "type": "integer", "minimum": 0 },
              "reasoningTokens": { "type": "integer", "minimum": 0 },
              "latencyMs": { "type": "integer", "minimum": 0 },
              "costUsd": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "artifacts": { "$ref": "#/$defs/stringList" },
          "evidence": { "$ref": "#/$defs/stringList" },
          "blockers": { "$ref": "#/$defs/stringList" },
          "reusableContext": { "$ref": "#/$defs/stringList" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } }
  }
}
